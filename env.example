# ============================================================
# CONFIGURACIÓN - RENOMBRAR A .env.local
# ============================================================

# Credenciales de Google Service Account (en formato JSON)
# Ver README.md para obtenerlas
# Ejemplo: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID de la planilla donde guardar los DESVÍOS
# Podés usar una nueva planilla o la de tareas (con hoja "Desvios")
# Ejemplo: 1XrWrRznjT7geN7kvR_L2yuTnthLAULTyr0JEaQVq7_o
DESVIOS_SPREADSHEET_ID=
